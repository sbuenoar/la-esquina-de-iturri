<section class="hero"><div>📝</div><h1>Inscripciones</h1><p>Un espacio para anotarse en actividades, encuentros y propuestas de las instituciones de la comunidad.</p></section>
<main>
<section class="card"><h2>Formulario de interés</h2>
<p class="notice">Completá el formulario para registrar tu inscripción en la base de datos comunitaria.</p>
<form id="demoForm">
<label for="lugar">Lugar o espacio solicitado</label>
<input id="lugar" name="lugar" maxlength="160" required
       placeholder="Ej.: salón comunitario">

<label for="nombre">Nombre y apellido</label>
<input id="nombre" name="nombre" maxlength="120" required>

<label for="contacto">WhatsApp de contacto</label>
<input id="contacto" name="contacto" type="tel" maxlength="40"
       required placeholder="Código de área y número">

<label for="actividad">Tipo de evento</label>
<select id="actividad" name="actividad" required>
  <option value="">Elegí una actividad</option>
  <option>Feria de Platos (sábados 14hs)</option>
  <option>Bingo Adultos Mayores (domingo 15h)</option>
  <option>Torneo de Bochas (sábados 18h)</option>
  <option>Jornada de Limpieza (viernes 18h)</option>
  <option>Foro y Urgencias (miércoles 18h)</option>
</select>

<label for="asistentes">Cantidad de asistentes</label>
<input id="asistentes" name="asistentes" type="number"
       min="1" max="1000" step="1" required>

<label for="comentario">Observaciones</label>
<textarea id="comentario" name="comentario" rows="3"
          maxlength="1200" placeholder="Detalles o necesidades especiales"></textarea>

<button type="submit">Enviar inscripción</button>
<p id="respuesta" role="status" aria-live="polite"></p>
</form></section>
<section class="card"><h2>¿Qué actividades se publicarán?</h2><ul><li>Ferias y kermesses.</li><li>Actividades escolares y de cooperadora.</li><li>Reuniones de vecinos.</li><li>Propuestas culturales, deportivas y solidarias.</li></ul></section>
<script type="module">
import { db, conectarUsuario } from "./firebase-init.js";
import {
  addDoc, collection, serverTimestamp
} from "https://www.gstatic.com/firebasejs/12.4.0/firebase-firestore.js";

const formulario = document.getElementById("demoForm");
const respuesta = document.getElementById("respuesta");
const boton = formulario.querySelector('button[type="submit"]');

formulario.addEventListener("submit", async (e) => {
  e.preventDefault();
  if (boton.disabled) return;

  const lugar = document.getElementById("lugar").value.trim();
  const nombre = document.getElementById("nombre").value.trim();
  const contacto = document.getElementById("contacto").value.trim();
  const actividad = document.getElementById("actividad").value.trim();
  const asistentes = Number(document.getElementById("asistentes").value);
  const comentario = document.getElementById("comentario").value.trim();

  if (!lugar || !nombre || !contacto || !actividad ||
      !Number.isInteger(asistentes) || asistentes < 1 || asistentes > 1000) {
    respuesta.textContent = "Revisá los datos obligatorios e ingresá una cantidad válida de asistentes.";
    return;
  }

  boton.disabled = true;
  respuesta.textContent = "Conectando con Firebase y guardando la inscripción…";

  try {
    await conectarUsuario();

    await addDoc(collection(db, "inscripciones"), {
      // Campos existentes, para mantener compatibilidad con las reglas actuales.
      actividad,
      nombre,
      contacto,

      // Datos de la planilla comunitaria.
      lugar,
      cantidadAsistentes: asistentes,
      observaciones: comentario,
      estado: "Pendiente",
      fechaInscripcion: serverTimestamp()
    });

    formulario.reset();
    respuesta.textContent =
      "¡Inscripción recibida! Quedó pendiente de confirmación por la organización.";
  } catch (error) {
    console.error("Error al guardar la inscripción:", error);
    respuesta.textContent =
      "No se pudo registrar la inscripción. Revisá la conexión y los permisos de Firebase e intentá nuevamente.";
  } finally {
    boton.disabled = false;
  }
});
</script></main>
