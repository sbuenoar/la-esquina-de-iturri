.iturri-musica #iturriPlay{width:58px;height:58px;border:0;border-radius:50%;background:#bfe9ff;color:#7cce32;font-size:29px;font-weight:900;cursor:pointer;box-shadow:0 3px 10px #0002}
.iturri-musica audio{display:none}
</style>
<script>
(() => {
 const selector=document.getElementById('iturriCancion');
 const audio=document.getElementById('iturriAudio');
 const boton=document.getElementById('iturriPlay');
 if(!selector||!audio||!boton)return;
 audio.volume=0.35;
 function actualizar(){
  const suena=!audio.paused&&!audio.ended;
  boton.textContent=suena?'Ⅱ':'▶';
  boton.setAttribute('aria-label',suena?'Pausar música':'Reproducir música');
 }
 boton.addEventListener('click',()=>{
  if(audio.paused)audio.play().then(actualizar).catch(actualizar);
  else{audio.pause();actualizar();}
 });
 selector.addEventListener('change',()=>{
  const sonaba=!audio.paused;
  audio.pause();audio.src=selector.value;audio.load();actualizar();
  if(sonaba)audio.play().then(actualizar).catch(actualizar);
 });
 audio.addEventListener('play',actualizar);
 audio.addEventListener('pause',actualizar);
 audio.addEventListener('ended',actualizar);
 window.addEventListener('load',()=>audio.play().then(actualizar).catch(actualizar));
 actualizar();
})();
</script>


<script id="iturri-js-musica-unificada">
(() => {
  const audio = document.getElementById('iturriAudio');
  const boton = document.getElementById('iturriPlay');
  const selector = document.querySelector('.iturri-musica select');

  if (!audio || !boton) {
    console.error('Reproductor de música incompleto en esta página.');
    return;
  }

  function actualizar() {
    const sonando = !audio.paused && !audio.ended;
    boton.textContent = sonando ? 'Ⅱ' : '▶';
    boton.setAttribute('aria-label', sonando ? 'Pausar música' : 'Reproducir música');
    boton.title = sonando ? 'Pausar música' : 'Reproducir música';
  }

  async function reproducir() {
    try {
      await audio.play();
    } catch (error) {
      console.info('El navegador puede requerir que pulses Reproducir.', error);
    }
    actualizar();
  }

  boton.addEventListener('click', () => {
    if (audio.paused || audio.ended) reproducir();
    else {
      audio.pause();
      actualizar();
    }
  });

  if (selector) {
    selector.addEventListener('change', async () => {
      const estabaSonando = !audio.paused;
      audio.pause();
      audio.src = selector.value;
      audio.load();
      actualizar();
      if (estabaSonando) await reproducir();
    });
  }

  ['play', 'pause', 'ended', 'loadeddata'].forEach(evento =>
    audio.addEventListener(evento, actualizar)
  );

  actualizar();
  window.addEventListener('load', reproducir);
})();
</script>

