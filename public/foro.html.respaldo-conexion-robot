<script type="module">
import { db, conectarUsuario } from "./firebase-init.js";
import {
  collection, addDoc, onSnapshot, serverTimestamp
} from "https://www.gstatic.com/firebasejs/12.4.0/firebase-firestore.js";

const formulario = document.getElementById("formulario");
const rango = document.getElementById("urgencia");
const lista = document.getElementById("listaReportes");
const respuesta = document.getElementById("respuesta");

let reportes = [];
let enviando = false;

rango.addEventListener("input", () => {
  document.getElementById("valorUrgencia").textContent = rango.value;
});

function escapar(s) {
  return String(s ?? "").replace(/[&<>"']/g, c => ({
    "&":"&amp;", "<":"&lt;", ">":"&gt;",
    '"':"&quot;", "'":"&#39;"
  })[c]);
}


function normalizarTexto(valor) {
  return String(valor ?? "")
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .replace(/\b(avenida|avda|av)\b/g, " ")
    .replace(/\b(calle|cal)\b/g, " ")
    .replace(/[^\p{L}\p{N}]+/gu, " ")
    .trim()
    .replace(/\s+/g, " ");
}

function similitudTexto(a, b) {
  const ignorar = new Set([
    "de", "la", "el", "en", "y", "por", "con",
    "un", "una", "del", "los", "las", "a"
  ]);

  const palabrasA = new Set(
    normalizarTexto(a).split(" ").filter(x => x && !ignorar.has(x))
  );
  const palabrasB = new Set(
    normalizarTexto(b).split(" ").filter(x => x && !ignorar.has(x))
  );

  if (!palabrasA.size || !palabrasB.size) return 0;

  const comunes = [...palabrasA].filter(x => palabrasB.has(x)).length;
  return comunes / new Set([...palabrasA, ...palabrasB]).size;
}


function fechaDelReporte(r) {
  // Preferir la marca de tiempo guardada por Firestore.
  const marca = r.creadoEn;

  if (marca && typeof marca.toDate === "function") {
    const fecha = marca.toDate();
    if (!Number.isNaN(fecha.getTime())) return fecha;
  }

  if (marca && Number.isFinite(marca.seconds)) {
    return new Date(marca.seconds * 1000);
  }

  // Compatibilidad con registros antiguos que solo tienen fecha.
  const texto = String(r.fecha ?? "").trim();
  const coincidencia = texto.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);

  if (coincidencia) {
    return new Date(
      Number(coincidencia[3]),
      Number(coincidencia[2]) - 1,
      Number(coincidencia[1]),
      12, 0, 0
    );
  }

  if (texto) {
    const fecha = new Date(texto);
    if (!Number.isNaN(fecha.getTime())) return fecha;
  }

  // Los registros sin fecha verificable se conservan en Firebase,
  // pero no se muestran como publicaciones recientes.
  return null;
}

function reportesDeLosUltimosSieteDias() {
  const ahora = Date.now();
  const limite = ahora - 7 * 24 * 60 * 60 * 1000;

  return reportes.filter(r => {
    const fecha = fechaDelReporte(r);
    if (!fecha) return false;

    const tiempo = fecha.getTime();
    return tiempo >= limite && tiempo <= ahora;
  });
}

function puntuacion(r, universo = reportes) {
  const categoria = normalizarTexto(r.categoria);
  const lugar = normalizarTexto(r.lugar);
  const detalle = normalizarTexto(r.detalle);

  // La similitud se calcula dentro del conjunto que se está evaluando.
  const similares = universo.filter(x => {
    if (x.id === r.id) return false;

    const mismaCategoria =
      categoria === normalizarTexto(x.categoria);
    if (!mismaCategoria) return false;

    const otroLugar = normalizarTexto(x.lugar);
    const otroDetalle = normalizarTexto(x.detalle);

    const lugarCoincide =
      Boolean(lugar && otroLugar && lugar === otroLugar);

    const descripcionParecida =
      similitudTexto(detalle, otroDetalle) >= 0.35;

    const ubicacionesRelacionadas =
      Boolean(lugar && otroLugar) &&
      (
        lugar.includes(otroLugar) ||
        otroLugar.includes(lugar) ||
        similitudTexto(lugar, otroLugar) >= 0.5
      );

    return lugarCoincide ||
      (descripcionParecida && ubicacionesRelacionadas);
  }).length;

  return Math.round(
    Number(r.urgencia) / 5 * 35 +
    Number(r.impacto) / 3 * 30 +
    Number(r.reiteracion) / 3 * 20 +
    (r.evidencia ? 10 : 0) +
    Math.min(similares, 5) / 5 * 5
  );
}


function reportesSemanaCalendarioAnterior() {
  return reportesDeLosUltimosSieteDias();
}


function textoProximaReunion() {
  const fecha = new Date();
  fecha.setHours(12, 0, 0, 0);

  // Miércoles = 3. Si hoy es miércoles, mostrar la reunión de hoy.
  const diasHastaMiercoles = (3 - fecha.getDay() + 7) % 7;
  fecha.setDate(fecha.getDate() + diasHastaMiercoles);

  return fecha.toLocaleDateString("es-AR", {
    weekday: "long",
    day: "numeric",
    month: "long",
    year: "numeric"
  });
}


function actualizarTemaSemanal(reportesSemana) {
  const titulo = document.getElementById("temaSemanalTitulo");
  const descripcion =
    document.getElementById("temaSemanalDescripcion");
  const meta = document.getElementById("temaSemanalMeta");
  const fechaReunion = textoProximaReunion();

  if (!reportesSemana.length) {
    titulo.textContent = "Tema pendiente de evaluación";
    descripcion.textContent =
      "No hay reclamos con fecha verificable en los últimos siete días.";
    meta.textContent =
      `Próxima reunión: ${fechaReunion}. Los registros históricos permanecen ` +
      "en Firebase para las estadísticas; no se elimina ningún reclamo.";
    return;
  }

  const grupos = new Map();

  for (const r of reportesSemana) {
    const clave = normalizarTexto(r.categoria) || "otro";

    if (!grupos.has(clave)) {
      grupos.set(clave, {
        categoria: r.categoria || "Otro",
        puntajeAcumulado: 0,
        elementos: []
      });
    }

    const grupo = grupos.get(clave);
    const puntos = puntuacion(r, reportesSemana);

    grupo.puntajeAcumulado += puntos;
    grupo.elementos.push({ reporte: r, puntos });
  }

  const elegidos = [...grupos.values()].sort(
    (a, b) =>
      b.puntajeAcumulado - a.puntajeAcumulado ||
      b.elementos.length - a.elementos.length
  );

  const elegido = elegidos[0];
  const clave = normalizarTexto(elegido.categoria);

  const nombresTemas = {
    "espacios verdes": "Arbolado urbano y espacios verdes",
    "calles y baches": "Estado de las calles, baches y veredas",
    "limpieza y residuos": "Limpieza y gestión de residuos",
    "alumbrado": "Alumbrado público",
    "seguridad": "Seguridad comunitaria",
    "salud": "Salud y acceso a servicios",
    "educacion": "Educación y apoyo escolar",
    "propuesta comunitaria": "Propuestas y actividades comunitarias"
  };

  titulo.textContent = nombresTemas[clave] || elegido.categoria;

  const ejemplos = elegido.elementos
    .sort((a, b) => b.puntos - a.puntos)
    .slice(0, 3)
    .map(({ reporte }) =>
      `${reporte.detalle || "Sin descripción"}`
      + (reporte.lugar ? ` (lugar: ${reporte.lugar})` : "")
    );

  descripcion.textContent =
    `${elegido.elementos.length} reclamo(s) o sugerencia(s) de esta categoría. ` +
    `Puntaje acumulado: ${elegido.puntajeAcumulado}. ` +
    `Casos representativos: ${ejemplos.join("; ")}.`;

  meta.textContent =
    `Tema propuesto para la reunión del ${fechaReunion}. ` +
    `Evaluación de ${reportesSemana.length} reclamo(s) o sugerencia(s) ` +
    `de los últimos siete días. Se suman los puntajes por categoría; ` +
    "la selección es orientativa y no reemplaza la evaluación de urgencias.";
}


function renderizar() {
  const visibles = reportesDeLosUltimosSieteDias();
  const semanaAnterior = visibles;

  // El tema semanal usa la semana calendario ya finalizada.
  actualizarTemaSemanal(semanaAnterior);

  if (!visibles.length) {
    lista.innerHTML =
      "<p>No hay publicaciones recientes para mostrar. " +
      "Los registros anteriores se conservan en Firebase para las estadísticas.</p>";
    return;
  }

  const ordenados = [...visibles].sort(
    (a, b) => puntuacion(b, visibles) - puntuacion(a, visibles)
  );

  lista.innerHTML = ordenados.map(r => `
    <article class="post">
      <div class="meta">
        <strong>Reclamo / sugerencia</strong> ·
        ${escapar(r.categoria)} · ${escapar(r.fecha)}
      </div>
      <h3>${escapar(r.lugar)}</h3>
      <p>${escapar(r.detalle)}</p>
      <p class="score">
        Prioridad orientativa: ${puntuacion(r, visibles)}/100
      </p>
      <p class="meta">
        Urgencia: ${escapar(r.urgencia)}/5 ·
        Impacto: ${escapar(r.impacto)}/3 ·
        Reiteración: ${escapar(r.reiteracion)}/3 ·
        Evidencia: ${r.evidencia ? "sí" : "no"}
      </p>
      <p class="meta">
        La puntuación orienta la prioridad, pero no verifica la veracidad
        ni reemplaza la evaluación de una emergencia.
      </p>
    </article>
  `).join("");
}

formulario.addEventListener("submit", async e => {
  e.preventDefault();
  if (enviando) return;

  enviando = true;
  const botonPublicar = formulario.querySelector('button[type="submit"]');
  botonPublicar.disabled = true;
  respuesta.textContent = "Conectando y guardando el reporte…";

  const reporte = {
    categoria: document.getElementById("categoria").value,
    lugar: document.getElementById("lugar").value.trim(),
    detalle: document.getElementById("detalle").value.trim(),
    urgencia: Number(rango.value),
    impacto: Number(document.getElementById("impacto").value),
    reiteracion: Number(document.getElementById("reiteracion").value),
    evidencia: document.getElementById("evidencia").checked,
    fecha: new Date().toLocaleDateString("es-AR")
  };

  try {
    await conectarUsuario();
    await addDoc(collection(db, "reclamos"), {
      ...reporte,
      creadoEn: serverTimestamp()
    });

    formulario.reset();
    document.getElementById("valorUrgencia").textContent = "3";
    respuesta.textContent =
      "¡Reporte guardado en Firebase! Ya puede aparecer en el ranking compartido.";
  } catch (error) {
    console.error("Error al guardar el reporte:", error);
    respuesta.textContent =
      "No se pudo guardar el reporte. Revisá la conexión y los permisos de Firebase e intentá nuevamente.";
  } finally {
    enviando = false;
    botonPublicar.disabled = false;
  }
});


try {
  await conectarUsuario();

  onSnapshot(collection(db, "reclamos"), snapshot => {
    reportes = snapshot.docs.map(doc => ({
      id: doc.id,
      ...doc.data()
    }));
    renderizar();
  }, error => {
    console.error("Error al leer reportes:", error);
    respuesta.textContent =
      "No se pudieron cargar los reportes. Revisá los permisos de Firestore.";
  });
} catch (error) {
  console.error("Error al conectar con Firebase:", error);
  respuesta.textContent =
    "No se pudo conectar con Firebase. Revisá Authentication y la conexión.";
}
</script>

